<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Calculator" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
    </style>

    <style name="ButtonBase" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ButtonNumberStyle" parent="ButtonBase">
        <item name="android:backgroundTint">@color/btn_number_bg</item>
        <item name="android:textColor">@color/btn_number_text</item>
        <item name="android:cornerRadius">44dp</item>
    </style>

    <style name="ButtonFunctionStyle" parent="ButtonBase">
        <item name="android:backgroundTint">@color/btn_function_bg</item>
        <item name="android:textColor">@color/btn_function_text</item>
        <item name="android:cornerRadius">44dp</item>
    </style>

    <style name="ButtonOperatorStyle" parent="ButtonBase">
        <item name="android:backgroundTint">@color/btn_operator_bg</item>
        <item name="android:textColor">@color/btn_operator_text</item>
        <item name="android:cornerRadius">44dp</item>
    </style>

    <style name="ButtonEqualsStyle" parent="ButtonBase">
        <item name="android:backgroundTint">@color/btn_equals_bg</item>
        <item name="android:textColor">@color/btn_equals_text</item>
        <item name="android:cornerRadius">44dp</item>
    </style>
</resources>
